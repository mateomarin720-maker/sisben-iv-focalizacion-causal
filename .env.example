# Copiar a .env y completar. .env está excluido de git (ver .gitignore).

# Token de aplicación Socrata (opcional, aumenta el límite de tasa de
# datos.gov.co). Se obtiene gratis en https://dev.socrata.com/register
SOCRATA_APP_TOKEN=

# Credenciales de acceso a microdatos restringidos, si el DNP/DANE las
# entrega en ese formato (completar cuando estén disponibles).
DNP_API_KEY=
DANE_ANDA_USER=

# Azure Blob Storage (banco de datos). Una de las dos:
# - equipo (lectura y escritura): cadena de conexión de la cuenta
AZURE_STORAGE_CONNECTION_STRING=
# - solo lectura, con vencimiento (la genera generar_acceso_lectura_azure.py)
AZURE_CONTAINER_SAS_URL=
